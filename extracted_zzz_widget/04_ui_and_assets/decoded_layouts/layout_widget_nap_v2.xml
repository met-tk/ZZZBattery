<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:background="@drawable/bg_widget_nap"
    android:layout_width="match_parent"
    android:layout_height="155dp">
    <ImageView
        android:id="@+id/iv_game_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/icon_widget_mys_logo"/>
    <TextView
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/tv_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:text="@string/widget_nap_name"
        android:layout_toRightOf="@+id/iv_game_icon"
        android:layout_alignTop="@+id/iv_game_icon"
        android:layout_alignBottom="@+id/iv_game_icon"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/tv_widget_title"
        android:layout_alignBottom="@+id/tv_widget_title"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:id="@+id/btn_refresh"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="刷新"
            android:drawableRight="@drawable/ic_nap_mini_widget_refresh"
            android:drawablePadding="2dp"
            android:layout_toLeftOf="@+id/tv_sign_tip"
            android:drawableTint="#e5ffffff"/>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:id="@+id/tv_sign_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="尚未签到"
            android:drawableRight="@drawable/ic_nap_mini_widget_arrow"
            android:drawablePadding="2dp"
            android:layout_toLeftOf="@+id/tv_launch_game"
            android:layout_marginStart="24dp"
            android:drawableTint="#e5ffffff"/>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:id="@+id/tv_launch_game"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="启动游戏"
            android:drawableRight="@drawable/ic_nap_mini_widget_arrow"
            android:drawablePadding="2dp"
            android:layout_marginStart="24dp"
            android:drawableTint="#e5ffffff"/>
    </LinearLayout>
    <include
        android:id="@+id/container_left"
        android:layout_width="123dp"
        android:layout_height="0dp"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="3dp"
        android:layout_below="@+id/iv_game_icon"
        android:layout_alignParentBottom="true"
        layout="@layout/layout_widget_nap_left"/>
    <include
        android:id="@+id/container_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="3dp"
        android:layout_toRightOf="@+id/container_left"
        android:layout_alignTop="@+id/container_left"
        android:layout_alignBottom="@+id/container_left"
        android:layout_alignParentRight="true"
        layout="@layout/layout_widget_nap_right"/>
    <include
        android:id="@+id/error_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="3dp"
        android:layout_below="@+id/iv_game_icon"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="3dp"
        layout="@layout/layout_widget_nap_error"/>
</RelativeLayout>
