<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@drawable/bg_nap_content_error"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_widget_nap_error_icon"
        android:scaleType="fitCenter"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp">
        <TextView
            android:textSize="10sp"
            android:textColor="#73ffffff"
            android:id="@+id/tv_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数据加载中..."/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/error_second_group"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <TextView
                android:textSize="10sp"
                android:textStyle="normal"
                android:textColor="#e5ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/second_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击进入米游社查看战绩"
                android:maxLines="1"/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_nap_mini_widget_arrow"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
