<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_nap_content_left"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_energy"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="11dp"
        android:layout_marginTop="19dp"
        android:src="@drawable/icon_widget_nap_energy"
        android:scaleType="fitCenter"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_toRightOf="@+id/iv_energy"
        android:layout_marginStart="4dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/gray_0_light_mys"
                android:id="@+id/tv_energy_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.03"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#a6ffffff"
                android:id="@+id/tv_energy_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/160"
                android:layout_toRightOf="@+id/tv_energy_current"
                android:layout_alignBaseline="@+id/tv_energy_current"
                android:letterSpacing="-0.03"/>
        </LinearLayout>
        <TextView
            android:textSize="10sp"
            android:textStyle="normal"
            android:textColor="#73ffffff"
            android:id="@+id/intervalTimeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/left_bottom_container"
        android:background="@drawable/bg_nap_content_left_bottom"
        android:paddingBottom="3dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/iv_energy"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
