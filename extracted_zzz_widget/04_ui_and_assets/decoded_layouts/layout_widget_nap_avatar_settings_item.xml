<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.mihoyo.sora.widget.vector.ClipLayout
        android:id="@+id/bgView"
        android:background="#333534"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,109:84"
        app:radius="8dp">
        <com.mihoyo.sora.widget.vector.ClipLayout
            android:background="#0a0a0a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1.5dp"
            app:radius="8dp">
            <com.mihoyo.sora.widget.vector.ClipLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="1.5dp"
                android:layout_marginHorizontal="1.5dp"
                app:topLeft="7dp"
                app:topRight="7dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.mihoyo.hyperion.kit.widget.FitTopImageView
                        android:id="@+id/avatarView"
                        android:background="#1d1f1e"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintDimensionRatio="H,109:64"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:textColor="#d9dbdd"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/nameView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/avatarView"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.mihoyo.sora.widget.vector.ClipLayout>
        </com.mihoyo.sora.widget.vector.ClipLayout>
    </com.mihoyo.sora.widget.vector.ClipLayout>
    <ImageView
        android:id="@+id/selectIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_widget_nap_setting_item_selected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
