<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="33dp">
    <ImageView
        android:id="@+id/startIconView"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/currentStateView"
        android:layout_toEndOf="@+id/startIconView">
        <TextView
            android:textSize="12sp"
            android:textColor="#e5ffffff"
            android:ellipsize="end"
            android:id="@+id/titleView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/tagView"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#a6ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tagView"
            android:background="@drawable/bg_nap_avatar_activity_time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="4dp"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/currentStateView"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_centerVertical="true"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#ffde00"
            android:gravity="center"
            android:id="@+id/currentStateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4000"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:id="@+id/totalStateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/8000"/>
    </LinearLayout>
    <TextView
        android:id="@+id/line"
        android:background="@color/white_8"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
