<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/loading"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_widget_nap_loading"
        android:adjustViewBounds="true"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/ivAvatar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_widget_nap_default_bg"
        android:adjustViewBounds="true"
        android:layout_alignTop="@+id/loading"
        android:layout_alignBottom="@+id/loading"
        android:layout_alignStart="@+id/loading"
        android:layout_alignEnd="@+id/loading"/>
    <FrameLayout
        android:id="@+id/topInfoGroup"
        android:background="@drawable/bg_widget_nap_top_info"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-12dp"
        android:layout_above="@+id/container_bottom"
        android:layout_alignStart="@+id/loading"
        android:layout_alignEnd="@+id/loading"
        android:layout_marginHorizontal="6dp">
        <RelativeLayout
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/iv_energy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_widget_nap_energy"
                android:scaleType="fitCenter"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_energy"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_0_light_mys"
                        android:id="@+id/tv_energy_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.03"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#e5ffffff"
                        android:id="@+id/tv_energy_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/160"
                        android:layout_toRightOf="@+id/tv_energy_current"
                        android:layout_alignBaseline="@+id/tv_energy_current"
                        android:letterSpacing="-0.03"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="normal"
                    android:textColor="#a6ffffff"
                    android:gravity="center"
                    android:id="@+id/intervalTimeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="bottom|right"
            android:id="@+id/activeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="12dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/bg_nap_avatar_top_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:layout_marginEnd="8dp">
                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/bg_widget_nap_avatar_cap"
                        android:scaleType="fitCenter"/>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/capFinishIv"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/bg_widget_nap_avatar_daily_finish"
                        android:layout_marginEnd="2dp"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/bg_widget_nap_avatar_video"
                        android:scaleType="fitCenter"/>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/videoFinishIv"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/bg_widget_nap_avatar_daily_finish"
                        android:layout_marginEnd="2dp"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/bg_widget_nap_avatar_guagua"
                        android:scaleType="fitCenter"/>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/guaguaFinishIv"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/bg_widget_nap_avatar_daily_finish"
                        android:layout_marginEnd="2dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:background="@drawable/bg_nap_avatar_top_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_widget_nap_avatar_daily_active"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#e5ffffff"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dailyTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/topGroup"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="2dp"
        android:layout_alignTop="@+id/loading"
        android:layout_alignStart="@+id/loading"
        android:layout_alignEnd="@+id/loading">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/launchGameGroup"
            android:background="@drawable/bg_nap_avatar_top_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:paddingVertical="2dp">
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/gray_0_light_mys"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启动游戏"/>
            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_nap_avatar_mini_widget_arrow"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/refreshGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/refreshView"
                android:background="@drawable/bg_nap_avatar_top_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:paddingVertical="2dp">
                <TextView
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_0_light_mys"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="刷新"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_nap_avatar_mini_widget_refresh"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/sign_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/tv_sign_tip"
                android:background="@drawable/bg_nap_avatar_top_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:paddingVertical="2dp">
                <TextView
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_0_light_mys"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/signTipTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="前往社区"/>
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_nap_avatar_mini_widget_arrow"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/settingGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivSetting"
                android:background="@drawable/bg_nap_avatar_top_btn"
                android:layout_width="18dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nap_avatar_mini_widget_settings"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/noteClickView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/topInfoGroup"
        android:layout_alignBottom="@+id/container_bottom"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container_bottom"
        android:background="@drawable/bg_nap_bottom_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_alignBottom="@+id/loading"
        android:layout_alignStart="@+id/loading"
        android:layout_alignEnd="@+id/loading"
        android:layout_marginHorizontal="6dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"/>
    <include
        android:id="@+id/error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="6dp"
        android:layout_alignBottom="@+id/loading"
        android:layout_alignStart="@+id/loading"
        android:layout_alignEnd="@+id/loading"
        android:layout_marginHorizontal="6dp"
        layout="@layout/layout_widget_nap_avatar_error"/>
</RelativeLayout>
