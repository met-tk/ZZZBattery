<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_nap_content_right"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">
    <RelativeLayout
        android:id="@+id/first_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_nap_right_tag"
            android:ellipsize="end"
            android:id="@+id/first_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawableLeft="@drawable/icon_widget_nap_tag"
            android:drawablePadding="4dp"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@+id/first_value"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_nap_highlight"
            android:gravity="center_vertical"
            android:id="@+id/first_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_alignTop="@+id/first_title"
            android:layout_alignBottom="@+id/first_title"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/line1"
        android:background="@color/widget_nap_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:id="@+id/second_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_nap_right_tag"
            android:ellipsize="end"
            android:id="@+id/second_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawableLeft="@drawable/icon_widget_nap_tag"
            android:drawablePadding="4dp"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@+id/second_value"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_nap_highlight"
            android:gravity="center_vertical"
            android:id="@+id/second_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_alignTop="@+id/second_title"
            android:layout_alignBottom="@+id/second_title"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/line2"
        android:background="@color/widget_nap_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:id="@+id/third_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_nap_right_tag"
            android:ellipsize="end"
            android:id="@+id/third_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawableLeft="@drawable/icon_widget_nap_tag"
            android:drawablePadding="4dp"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@+id/third_value"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_nap_highlight"
            android:gravity="center_vertical"
            android:id="@+id/third_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_alignTop="@+id/third_title"
            android:layout_alignBottom="@+id/third_title"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/line3"
        android:background="@color/widget_nap_line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <RelativeLayout
        android:id="@+id/fourth_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_nap_right_tag"
            android:ellipsize="end"
            android:id="@+id/fourth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawableLeft="@drawable/icon_widget_nap_tag"
            android:drawablePadding="4dp"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@+id/fourth_value"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_nap_highlight"
            android:gravity="center_vertical"
            android:id="@+id/fourth_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_alignTop="@+id/fourth_title"
            android:layout_alignBottom="@+id/fourth_title"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>
