<Window x:Class="ZzzBattery.Windows.AccountWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="连接米游社 — 绝区零桌面电量" Style="{StaticResource {x:Type Window}}" Width="940" Height="760" MinWidth="640" MinHeight="480"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="连接你的米游社账号" FontSize="21" FontWeight="SemiBold"/>
   <TextBlock Text="推荐使用米游社 App 扫码连接，以同步完整小组件信息。也可在下方官方网页登录；登录凭据仅在本机加密保存。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <Button Content="扫码连接（推荐）" Click="QrLoginClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
   <Button Content="返回米游社首页" Click="BrowserTab" Margin="0,0,8,0"/>
   <Button Content="手动导入凭据" Click="ImportTab" Margin="0,0,8,0"/>
   <Button Content="打开通行证页面" Click="PassportClick" Margin="0,0,8,0"/>
   <Button Content="重载网页" Click="ReloadClick"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <Grid x:Name="BrowserPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock x:Name="AddressText" Text="https://www.miyoushe.com/zzz/" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
    <wv:WebView2 x:Name="Browser" Grid.Row="1"/>
   </Grid>
   <StackPanel x:Name="ImportPanel" Visibility="Collapsed" Margin="20">
    <TextBlock Text="导入自己的米游社 Cookie" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="完整小组件信息：需要本人账号的 stoken / stuid / mid。只有网页 Cookie 时仍可查看实时便笺，但咖啡和部分活动可能缺失。" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,12,0,0"/>
    <TextBlock Text="粘贴你本人账号的 Cookie，或导入旧版 credentials.json。输入会被遮挡，验证成功后才会保存。请勿导入他人的凭据。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,16"/>
    <PasswordBox x:Name="CookieInput" MaxLength="32768" AutomationProperties.Name="米游社 Cookie" Margin="0,0,0,12"/>
    <Button Content="选择凭据文件…" HorizontalAlignment="Left" Click="ImportFile"/>
    <TextBlock Text="备用操作：在浏览器登录米游社，打开开发者工具的网络面板，刷新页面，在发送到米游社的请求头中复制 Cookie 的值。完成后将其粘贴到上方，再点“读取游戏角色”。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,20,0,0"/>
   </StackPanel>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="Status" Text="请先在网页中点击“登录”，完成后读取角色。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,8"/>
  <ProgressBar Grid.Row="4" x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>
  <Grid Grid.Row="5">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="Roles" DisplayMemberPath="DisplayName" Foreground="#171B14" Background="White" VerticalContentAlignment="Center" MinHeight="36" Visibility="Collapsed" Margin="0,0,12,0" AutomationProperties.Name="绝区零角色"/>
   <Button x:Name="ReadButton" Content="读取游戏角色" Grid.Column="1" Click="ReadRoles" Margin="0,0,8,0"/>
   <Button x:Name="UseButton" Content="使用此角色" Grid.Column="2" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="UseRole"/>
  </Grid>
 </Grid>
</Window>
