<Window x:Class="ZzzBattery.Windows.WallpaperWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ZzzBattery.Windows"
 Title="选择壁纸 — 绝区零桌面电量" Style="{StaticResource {x:Type Window}}"
 Width="980" Height="790" MinWidth="480" MinHeight="420" Background="#282A29" Foreground="#F0F0F0" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="AccentText" Color="#FFDE00"/>
  <SolidColorBrush x:Key="Ink" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Panel" Color="#333534"/>
  <SolidColorBrush x:Key="Stroke" Color="#444746"/>
  <SolidColorBrush x:Key="Muted" Color="#9FA4A1"/>
  <Style x:Key="WallpaperItem" TargetType="ListBoxItem">
   <Setter Property="Margin" Value="7,7,7,13"/><Setter Property="Padding" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid>
     <Border x:Name="TileFrame" Background="#0A0A0A" BorderBrush="#333534" BorderThickness="3" CornerRadius="12" Padding="3"><ContentPresenter/></Border>
     <Border x:Name="Check" Background="#FFDE00" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Visibility="Collapsed"><TextBlock Text="✓" Foreground="#141414" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="TileFrame" Property="BorderBrush" Value="#FFDE00"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileFrame" Property="Opacity" Value=".8"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TileFrame" Property="BorderBrush" Value="#FFF1A6"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="24,16">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="选择壁纸" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock x:Name="CatalogCount" FontSize="12" Foreground="#9FA4A1" Margin="0,3,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <Button x:Name="RefreshCatalogButton" Content="⟳  更新壁纸" Click="RefreshCatalogClick"/>
    <Button x:Name="PreviewToggle" Content="查看预览" Click="PreviewToggleClick" Margin="0,5,0,0" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="GalleryLayout" Grid.Row="1" SizeChanged="GalleryLayoutSized">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="PreviewColumn" Width="344"/></Grid.ColumnDefinitions>
   <Grid x:Name="GalleryPane">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="26,0,14,14">
     <Expander Header="属性与特性筛选" x:Name="FilterExpander" IsExpanded="True" Foreground="#D9DBDD">
      <StackPanel Margin="0,8,0,0">
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="属性" VerticalAlignment="Top" Margin="0,13,0,0" FontSize="14"/>
      <WrapPanel x:Name="ElementFilters" Grid.Column="1"/>
     </Grid>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="特性" VerticalAlignment="Top" Margin="0,13,0,0" FontSize="14"/>
      <WrapPanel x:Name="ProfessionFilters" Grid.Column="1"/>
     </Grid>
      </StackPanel>
     </Expander>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid>
       <TextBox x:Name="SearchBox" TextChanged="SearchChanged" Background="#1D1F1E" Foreground="#F0F0F0" CaretBrush="White" BorderBrush="#414542" Padding="10,7" ToolTip="搜索角色或皮肤名称" AutomationProperties.Name="搜索角色或皮肤名称"/>
       <TextBlock Text="搜索角色或皮肤" Foreground="#8E958F" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Button Content="全部" Grid.Column="1" Margin="10,0,0,0" Click="ResetFiltersClick" ToolTip="清除筛选和搜索"/>
     </Grid>
    </StackPanel>
    <Grid Grid.Row="1" Background="#1D1F1E">
     <ListBox x:Name="WallpaperList" Background="Transparent" BorderThickness="0" Padding="16,12,10,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
       ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="GalleryScrolled" SizeChanged="GallerySized" ItemContainerStyle="{StaticResource WallpaperItem}" SelectionChanged="WallpaperSelected">
      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding GalleryColumns, RelativeSource={RelativeSource AncestorType={x:Type local:WallpaperWindow}}}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel ToolTip="{Binding Name}">
        <Grid Height="96" Background="{Binding Background}">
         <TextBlock Text="{Binding Placeholder}" Foreground="#CC151716" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Rectangle Loaded="ThumbnailLoaded" RadiusX="7" RadiusY="7">
          <Rectangle.Fill><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top"/></Rectangle.Fill>
         </Rectangle>
         <TextBlock Text="{Binding ImageStatus}" Background="#C0151716" Foreground="#EEEFEA" FontSize="10" VerticalAlignment="Bottom" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ImageStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <TextBlock Text="{Binding Name}" Foreground="#D9DBDD" FontSize="13" Margin="2,6,2,7" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="EmptyText" Text="没有符合条件的壁纸" Foreground="#9FA4A1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
   </Grid>
   <Border x:Name="PreviewPane" Grid.Column="1" Background="#222423" BorderBrush="#363936" BorderThickness="1,0,0,0" Padding="22,20">
    <ScrollViewer Style="{StaticResource WidgetScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Margin="0,0,0,18"><TextBlock Text="小组件预览" FontSize="14"/><TextBlock Text="演示数据" Foreground="#9FA4A1" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="360" HorizontalAlignment="Stretch"><local:CharacterCard x:Name="PreviewCard" IsHitTestVisible="False"/></Viewbox>
     <TextBlock x:Name="SelectedName" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,8" TextWrapping="Wrap"/>
     <TextBlock x:Name="PreviewStatus" Foreground="#A9AEAA" FontSize="12" TextWrapping="Wrap" MinHeight="38"/>
     <Button x:Name="ApplyButton" Content="应用到桌面" Click="ApplyClick" Background="#FFDE00" Foreground="#151716" FontWeight="SemiBold" Margin="0,18,0,0" Padding="12,12" IsEnabled="False"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="26,13">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="CatalogStatus" Text="正在读取壁纸…" Foreground="#9FA4A1" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <Button Grid.Column="1" Content="关闭" Click="CloseClick" Padding="18,6"/>
  </Grid>
 </Grid>
</Window>
