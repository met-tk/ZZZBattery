<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ZZZBattery</AssemblyName>
    <RootNamespace>ZzzBattery.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\battery.ico</ApplicationIcon>
    <Version>1.2.9</Version>
    <Description>绝区零桌面电量 · 米游社实时便笺</Description>
    <Product>绝区零桌面电量</Product>
    <NuGetAudit>false</NuGetAudit>
    <!-- WPF owns DPI awareness; Windows Forms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZzzBattery.Core\ZzzBattery.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <Resource Include="Assets\battery.png" />
    <Resource Include="Assets\battery.ico" />
    <Resource Include="Assets\Widget\*" />
  </ItemGroup>
</Project>

