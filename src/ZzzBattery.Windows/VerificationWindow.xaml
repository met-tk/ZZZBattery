<Window x:Class="ZzzBattery.Windows.VerificationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="电量查询验证 — 绝区零桌面电量" Style="{StaticResource {x:Type Window}}" WindowStyle="None" AllowsTransparency="True"
 Width="620" Height="680" MinWidth="480" MinHeight="520" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid Background="{DynamicResource WindowSurface}">
  <Border Margin="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource WindowStroke}" BorderThickness="1" CornerRadius="18">
  <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
  <Border Grid.Row="0" Margin="10,8,10,0" Background="{DynamicResource WindowSurfaceRaised}" BorderBrush="{DynamicResource WindowStroke}" BorderThickness="1" CornerRadius="12"><Grid x:Name="ChromeBar" MouseLeftButtonDown="ChromeMouseLeftButtonDown" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource WidgetPinkSoft}" BorderBrush="{DynamicResource WidgetPink}" BorderThickness="1"><TextBlock Text="!" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WidgetPink}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="恢复电量同步" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="绝区零桌面电量  ·  官方验证" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,1,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0"><Button Style="{StaticResource WindowChromeButton}" Click="MinimizeClick" ToolTip="最小化" AutomationProperties.Name="最小化"><TextBlock Text="—" FontSize="16"/></Button><Button x:Name="MaximizeButton" Style="{StaticResource WindowChromeButton}" Click="MaximizeClick" ToolTip="最大化" AutomationProperties.Name="最大化"><TextBlock x:Name="MaximizeGlyph" Text="□" FontSize="14"/></Button><Button Style="{StaticResource WindowChromeCloseButton}" Click="CloseWindowClick" ToolTip="关闭" AutomationProperties.Name="关闭"><TextBlock Text="×" FontSize="20" FontWeight="Light"/></Button></StackPanel></Grid></Border>
  <Grid Grid.Row="1" Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock x:Name="TitleText" Text="恢复电量同步" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock x:Name="DescText" Text="验证码只会在官方要求时出现。若已看到电量，无需寻找验证码；程序会尝试同步所选角色的数据。若页面要求登录，请在这里登录。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <Border x:Name="PageViewport" Grid.Row="1" Background="{DynamicResource WindowSurfaceRaised}" BorderBrush="{DynamicResource WindowStroke}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
   <Grid>
    <wv:WebView2 x:Name="ChallengeBrowser" Visibility="Hidden" HorizontalAlignment="Center"/>
    <StackPanel x:Name="PageStatePanel" VerticalAlignment="Center" Margin="26">
     <TextBlock x:Name="PageStateTitle" Text="正在准备验证页面" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="PageStateHint" Text="首次打开需要几秒，请稍候。" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,18"/>
     <ProgressBar x:Name="PageProgress" Height="3" MaxWidth="240" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{DynamicResource Stroke}" BorderThickness="0"/>
     <Button x:Name="PageReloadButton" Content="重新加载页面" Click="RetryClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>
    </StackPanel>
   </Grid>
  </Border>
  <TextBlock x:Name="Status" Grid.Row="2" Text="正在加载官方绝区零便笺页面…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,12"/>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <WrapPanel Margin="0,0,8,0">
    <Button x:Name="CheckSyncButton" Content="检查同步" Click="CheckSyncClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
    <Button x:Name="RetryButton" Content="重载页面" Click="RetryClick" Margin="0,0,8,6"/>
    <Button x:Name="SwitchModeButton" Content="快速验证码" Click="SwitchModeClick" Margin="0,0,8,6"/>
    <Button x:Name="ExternalButton" Content="系统浏览器打开" Click="OfficialClick" Margin="0,0,8,6"/>
   </WrapPanel>
   <Button Grid.Column="1" Content="关闭" Click="CloseClick" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
  </Grid>
  </Grid>
  </Grid>
  </Border>
 </Grid>
</Window>
