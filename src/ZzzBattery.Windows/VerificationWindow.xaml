<Window x:Class="ZzzBattery.Windows.VerificationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="电量查询验证 — 绝区零桌面电量" Style="{StaticResource {x:Type Window}}"
 Width="620" Height="680" MinWidth="480" MinHeight="520" WindowStartupLocation="CenterScreen">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock x:Name="TitleText" Text="恢复电量同步" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock x:Name="DescText" Text="验证码只会在官方要求时出现。若已看到电量，无需寻找验证码；程序会尝试同步所选角色的数据。若页面要求登录，请在这里登录。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <Border x:Name="PageViewport" Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="8" ClipToBounds="True">
   <Grid>
    <wv:WebView2 x:Name="ChallengeBrowser" Visibility="Hidden" HorizontalAlignment="Center"/>
    <StackPanel x:Name="PageStatePanel" VerticalAlignment="Center" Margin="26">
     <TextBlock x:Name="PageStateTitle" Text="正在准备验证页面" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="PageStateHint" Text="首次打开需要几秒，请稍候。" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,18"/>
     <ProgressBar x:Name="PageProgress" Height="3" MaxWidth="240" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{DynamicResource Stroke}" BorderThickness="0"/>
     <Button x:Name="PageReloadButton" Content="重新加载页面" Click="RetryClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>
    </StackPanel>
   </Grid>
  </Border>
  <TextBlock x:Name="Status" Grid.Row="2" Text="正在加载官方绝区零便笺页面…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,12"/>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <WrapPanel Margin="0,0,8,0">
    <Button x:Name="CheckSyncButton" Content="检查同步" Click="CheckSyncClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
    <Button x:Name="RetryButton" Content="重载页面" Click="RetryClick" Margin="0,0,8,6"/>
    <Button x:Name="SwitchModeButton" Content="快速验证码" Click="SwitchModeClick" Margin="0,0,8,6"/>
    <Button x:Name="ExternalButton" Content="系统浏览器打开" Click="OfficialClick" Margin="0,0,8,6"/>
   </WrapPanel>
   <Button Grid.Column="1" Content="关闭" Click="CloseClick" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
  </Grid>
 </Grid>
</Window>
