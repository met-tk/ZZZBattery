<UserControl x:Class="ZzzBattery.Windows.CharacterCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="360" Height="420" Foreground="#F4F4F4" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <Style x:Key="Pill" TargetType="Button">
   <Setter Property="Foreground" Value="#F7F4F7"/><Setter Property="Background" Value="#88302931"/>
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="9,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PillBorder" Property="Background" Value="#CC302931"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PillBorder" Property="BorderBrush" Value="White"/><Setter TargetName="PillBorder" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PillBorder" Property="Opacity" Value=".45"/></Trigger>
     <MultiTrigger>
      <MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False"/><Condition Property="Content" Value="已签到"/></MultiTrigger.Conditions>
      <Setter TargetName="PillBorder" Property="Opacity" Value="1"/>
     </MultiTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HeaderPill" TargetType="Button" BasedOn="{StaticResource Pill}">
   <Setter Property="FontSize" Value="10.5"/><Setter Property="Padding" Value="7,3"/>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="CardRoot" Background="#ee73a4">
  <Grid.Clip><RectangleGeometry Rect="0,0,360,420" RadiusX="26" RadiusY="26"/></Grid.Clip>
  <Image Source="Assets/Widget/bg_nap_avatar_mini_widget_card_letter.png" Width="360" Height="107" Margin="0,62,0,0" VerticalAlignment="Top" Stretch="Fill"/>
  <Image x:Name="Artwork" Width="360" Height="480" VerticalAlignment="Top" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
  <Rectangle x:Name="BottomWash" Height="150" VerticalAlignment="Bottom"/>
  <Grid Margin="14,16,14,0" Height="24" VerticalAlignment="Top">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Content="启动游戏 ❯" Width="68" Style="{StaticResource HeaderPill}" Click="LaunchClick" ToolTip="启动绝区零；首次使用可选择游戏程序"/>
   <Button x:Name="DailySignButton" Grid.Column="1" Content="今日签到" Width="64" Style="{StaticResource HeaderPill}" Click="SignClick" Margin="6,0,0,0"
    ToolTip="为当前登录账号的绝区零角色进行每日签到" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="今日签到"/>
   <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新 ⟳" Width="50" Style="{StaticResource HeaderPill}" Click="RefreshClick" Margin="0,0,6,0"/>
   <Button Grid.Column="4" Content="前往社区 ❯" Width="72" Style="{StaticResource HeaderPill}" Click="CommunityClick" Margin="0,0,6,0"/>
   <Button Grid.Column="5" Content="&#xE713;" Width="24" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource HeaderPill}" Padding="6,3" Click="WallpaperClick" ToolTip="选择壁纸" AutomationProperties.Name="选择壁纸"/>
  </Grid>
  <!-- A single rounded surface owns the whole panel, including the lower corners. -->
  <Border x:Name="DataSurface" Margin="8,0,8,8" Height="220" VerticalAlignment="Bottom" Background="#ED171B1B" CornerRadius="21" Padding="12,9,12,7">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="59"/><RowDefinition Height="32"/><RowDefinition Height="1"/><RowDefinition Height="86"/><RowDefinition Height="26"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image Source="Assets/Widget/icon_widget_nap_energy.png" Width="34" Height="42"/>
     <StackPanel Grid.Column="1" Margin="7,0,0,0">
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="Energy" Text="—" FontFamily="Arial" FontSize="29" FontWeight="Bold"/><TextBlock x:Name="Maximum" Text="/—" FontSize="15" Margin="2,0,0,3" VerticalAlignment="Bottom"/></StackPanel>
      <TextBlock x:Name="Recovery" Text="连接后查看电量" Foreground="#C0C6C4" FontSize="10" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Border Grid.Column="2" Background="#802E3732" CornerRadius="12" Padding="8,5" VerticalAlignment="Center">
      <StackPanel><TextBlock Text="今日活跃" FontSize="9" Foreground="#B2BFB9"/><TextBlock x:Name="Vitality" Text="—/—" FontWeight="SemiBold" FontSize="14"/></StackPanel>
     </Border>
    </Grid>
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,1,0,3">
     <Border x:Name="CoffeeStatus" Background="#66364036" CornerRadius="7" Margin="0,0,4,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="Assets/Widget/bg_widget_nap_avatar_cap.png" Width="17" Height="17" Margin="0,0,3,0"/><TextBlock Text="咖啡" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="CoffeeMark" Text="?" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
     <Border x:Name="VideoStatus" Background="#66364036" CornerRadius="7" Margin="2,0,2,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="Assets/Widget/bg_widget_nap_avatar_video.png" Width="17" Height="17" Margin="0,0,3,0"/><TextBlock Text="录像店经营" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="VideoMark" Text="?" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
     <Border x:Name="ScratchStatus" Background="#66364036" CornerRadius="7" Margin="4,0,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="Assets/Widget/bg_widget_nap_avatar_guagua.png" Width="17" Height="17" Margin="0,0,3,0"/><TextBlock FontSize="9" TextAlignment="Center" VerticalAlignment="Center"><Run Text="饼铺盲盒/"/><LineBreak/><Run Text="刮刮卡/占卜"/></TextBlock><TextBlock x:Name="ScratchMark" Text="?" FontSize="12" FontWeight="Bold" Margin="3,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
    </UniformGrid>
    <Border Grid.Row="2" Background="#283D4941"/>
    <StackPanel x:Name="SummaryRows" Grid.Row="3" Margin="0,3,0,0"/>
    <Grid Grid.Row="4">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="AllNotes" Content="全部便笺 ›" Style="{StaticResource Pill}" Background="Transparent" Padding="2,3" HorizontalAlignment="Left" Click="DetailsClick"/>
     <Button x:Name="PreviousPage" Grid.Column="1" Content="‹" Style="{StaticResource Pill}" Padding="8,1" Click="PreviousClick" AutomationProperties.Name="上一页便笺"/>
     <TextBlock x:Name="PageNumber" Grid.Column="2" Text="1 / 1" FontSize="10" Foreground="#B2BFB9" Margin="7,0" VerticalAlignment="Center"/>
     <Button x:Name="NextPage" Grid.Column="3" Content="›" Style="{StaticResource Pill}" Padding="8,1" Click="NextClick" AutomationProperties.Name="下一页便笺"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
